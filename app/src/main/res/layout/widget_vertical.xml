<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/widget_background">
<TextView android:id="@+id/city" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C6DDFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/temp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="25sp" android:fontFamily="sans-serif-light"/>
<TextView android:id="@+id/details" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E1E8F2" android:textSize="11sp"/>
<LinearLayout android:id="@+id/forecast" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"/>
<ImageView android:id="@+id/chart" android:layout_width="match_parent" android:layout_height="36dp" android:visibility="gone" android:contentDescription="@string/rain_graph"/>
</LinearLayout>